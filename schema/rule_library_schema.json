{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rule library (PRD §3.2)",
  "type": "object",
  "additionalProperties": false,
  "required": ["corpus", "drawing_count", "rules", "do_not_list", "palette_summary", "material_summary", "proportion_summary", "signature_moves", "generic_rules_removed"],
  "properties": {
    "corpus": {"type": "string"},
    "drawing_count": {"type": "integer", "minimum": 1},
    "rules": {"type": "array", "minItems": 10, "maxItems": 15, "items": {"type": "object", "additionalProperties": false,
      "required": ["id", "title", "statement", "evidence_sheet_ids", "frequency", "counter_example_sheet_ids"],
      "properties": {
        "id": {"type": "string", "pattern": "^R[0-9]{2}$"},
        "title": {"type": "string"},
        "statement": {"type": "string"},
        "evidence_sheet_ids": {"type": "array", "minItems": 3, "items": {"type": "string"}},
        "frequency": {"enum": ["always", "usually", "sometimes"]},
        "counter_example_sheet_ids": {"type": "array", "items": {"type": "string"}}
      }}},
    "do_not_list": {"type": "array", "items": {"type": "string"}},
    "palette_summary": {"type": "object", "additionalProperties": false, "required": ["dominant", "accent", "warm_or_cool"],
      "properties": {"dominant": {"type": "array", "items": {"type": "string"}}, "accent": {"type": "array", "items": {"type": "string"}}, "warm_or_cool": {"type": "string"}}},
    "material_summary": {"type": "array", "items": {"type": "string"}},
    "proportion_summary": {"type": "array", "items": {"type": "string"}},
    "signature_moves": {"type": "array", "maxItems": 3, "items": {"type": "string"}},
    "generic_rules_removed": {"type": "array", "items": {"type": "string"}}
  }
}
